{
    "name": "hossamelkady/laravel-arabic-tools",
    "description": "Arabic helpers for Laravel: numbers to words, Arabic-Indic digits, Hijri dates, Arabic slugs.",
    "keywords": ["laravel", "arabic", "number-to-words", "hijri", "slug", "egp"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "HossamElkady\\ArabicTools\\": "src/" },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "HossamElkady\\ArabicTools\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["HossamElkady\\ArabicTools\\ArabicToolsServiceProvider"],
            "aliases": { "Arabic": "HossamElkady\\ArabicTools\\Facades\\Arabic" }
        }
    },
    "scripts": { "test": "phpunit" },
    "minimum-stability": "stable",
    "prefer-stable": true
}
